        {
          "@type": "DefinedTerm",
          "@id": "https://tijdgieterij.nl/ontology/collodion-wetplate#PotassiumCyanideFixer",
          "name": "Potassium cyanide fixer",
          "description": "A fast, traditional fixer based on potassium cyanide; acutely toxic and used only with appropriate expertise.",
