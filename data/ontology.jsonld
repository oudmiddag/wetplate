          "@id": "https://tijdgieterij.nl/ontology/collodion-wetplate#Sensitizing",
          "name": "Sensitizing in the silver bath",
          "description": "Immersing the coated plate in a silver nitrate bath so light-sensitive silver halides form in the collodion film.",
          "inDefinedTermSet": "https://tijdgieterij.nl/ontology/collodion-wetplate#CollodionWetplateOntology/glossary"
        },
        {
          "@type": "DefinedTerm",
          "@id": "https://tijdgieterij.nl/ontology/collodion-wetplate#Sharpness",
          "name": "Sharpness",
          "description": "The crispness of detail rendered in the image.",
          "inDefinedTermSet": "https://tijdgieterij.nl/ontology/collodion-wetplate#CollodionWetplateOntology/glossary"
        },
        {
          "@type": "DefinedTerm",
          "@id": "https://tijdgieterij.nl/ontology/collodion-wetplate#SilverBromide",
          "name": "Silver bromide",
          "description": "The light-sensitive salt formed when a bromide meets silver nitrate.",
          "inDefinedTermSet": "https://tijdgieterij.nl/ontology/collodion-wetplate#CollodionWetplateOntology/glossary",
          "url": "https://en.wikipedia.org/wiki/Silver_bromide"
        },
        {
          "@type": "DefinedTerm",
          "@id": "https://tijdgieterij.nl/ontology/collodion-wetplate#SilverIodide",
          "name": "Silver iodide",
          "description": "The light-sensitive salt formed when an iodide meets silver nitrate.",
          "inDefinedTermSet": "https://tijdgieterij.nl/ontology/collodion-wetplate#CollodionWetplateOntology/glossary",
          "url": "https://en.wikipedia.org/wiki/Silver_iodide"
        },
        {
          "@type": "DefinedTerm",
          "@id": "https://tijdgieterij.nl/ontology/collodion-wetplate#SilverNitrate",
          "name": "Silver nitrate",
          "description": "The silver salt that sensitises the plate by forming silver halides in the collodion.",
          "inDefinedTermSet": "https://tijdgieterij.nl/ontology/collodion-wetplate#CollodionWetplateOntology/glossary",
          "url": "https://en.wikipedia.org/wiki/Silver_nitrate"
        },
        {
          "@type": "DefinedTerm",
          "@id": "https://tijdgieterij.nl/ontology/collodion-wetplate#SilverNitrateBath",
          "name": "Silver nitrate bath",
          "description": "An aqueous silver nitrate solution that sensitises the coated plate; it needs regular testing, filtering and sunning.",
          "inDefinedTermSet": "https://tijdgieterij.nl/ontology/collodion-wetplate#CollodionWetplateOntology/glossary"
        },
        {
          "@type": "DefinedTerm",
          "@id": "https://tijdgieterij.nl/ontology/collodion-wetplate#SodiumThiosulfate",
          "name": "Sodium thiosulfate",
          "description": "Hypo; dissolves unexposed silver salts during fixing.",
          "inDefinedTermSet": "https://tijdgieterij.nl/ontology/collodion-wetplate#CollodionWetplateOntology/glossary",
          "url": "https://en.wikipedia.org/wiki/Sodium_thiosulfate"
        },
        {
          "@type": "DefinedTerm",
          "@id": "https://tijdgieterij.nl/ontology/collodion-wetplate#SodiumThiosulfateFixer",
          "name": "Sodium thiosulfate fixer",
          "description": "A fixer based on sodium thiosulfate (hypo); slower but far safer than cyanide.",
          "inDefinedTermSet": "https://tijdgieterij.nl/ontology/collodion-wetplate#CollodionWetplateOntology/glossary"
        },
        {
          "@type": "DefinedTerm",
          "@id": "https://tijdgieterij.nl/ontology/collodion-wetplate#StudioCamera",
          "name": "Studio camera",
          "description": "A heavier large-format camera on a stand for studio portraiture.",
          "inDefinedTermSet": "https://tijdgieterij.nl/ontology/collodion-wetplate#CollodionWetplateOntology/glossary"
        },
        {
          "@type": "DefinedTerm",
          "@id": "https://tijdgieterij.nl/ontology/collodion-wetplate#Sugar",
          "name": "Sugar (sucrose)",
          "description": "Sucrose added to a developer to slow and smooth development.",
          "inDefinedTermSet": "https://tijdgieterij.nl/ontology/collodion-wetplate#CollodionWetplateOntology/glossary",
          "url": "https://en.wikipedia.org/wiki/Sucrose"
        },
        {
          "@type": "DefinedTerm",
          "@id": "https://tijdgieterij.nl/ontology/collodion-wetplate#SugarDeveloper",
          "name": "Sugar developer",
          "description": "An iron developer with added sugar that slows action and smooths tonality, popular for portraits.",
          "inDefinedTermSet": "https://tijdgieterij.nl/ontology/collodion-wetplate#CollodionWetplateOntology/glossary"
        },
        {
          "@type": "DefinedTerm",
          "@id": "https://tijdgieterij.nl/ontology/collodion-wetplate#SugarDeveloperRecipe",
          "name": "Sugar developer recipe",
          "description": "A developer formulation with added sugar for smoother tonality.",
          "inDefinedTermSet": "https://tijdgieterij.nl/ontology/collodion-wetplate#CollodionWetplateOntology/glossary"
        },
        {
          "@type": "DefinedTerm",
          "@id": "https://tijdgieterij.nl/ontology/collodion-wetplate#Sunlight",
          "name": "Sunlight",
          "description": "Daylight, rich in the blue and UV that collodion is sensitive to.",
          "inDefinedTermSet": "https://tijdgieterij.nl/ontology/collodion-wetplate#CollodionWetplateOntology/glossary"
        },
        {
          "@type": "DefinedTerm",
          "@id": "https://tijdgieterij.nl/ontology/collodion-wetplate#Temperature",
          "name": "Temperature",
          "description": "Ambient and bath temperature, which changes coating, sensitising and development times.",
          "inDefinedTermSet": "https://tijdgieterij.nl/ontology/collodion-wetplate#CollodionWetplateOntology/glossary"
        },
        {
          "@type": "DefinedTerm",
          "@id": "https://tijdgieterij.nl/ontology/collodion-wetplate#Tintype",
          "name": "Tintype (ferrotype)",
          "description": "A collodion positive made directly on a blackened metal plate; robust and inexpensive.",
          "inDefinedTermSet": "https://tijdgieterij.nl/ontology/collodion-wetplate#CollodionWetplateOntology/glossary",
          "url": "https://en.wikipedia.org/wiki/Tintype"
        },
        {
          "@type": "DefinedTerm",
          "@id": "https://tijdgieterij.nl/ontology/collodion-wetplate#UVIntensity",
          "name": "UV intensity",
          "description": "The amount of ultraviolet light present, which strongly drives collodion exposure.",
          "inDefinedTermSet": "https://tijdgieterij.nl/ontology/collodion-wetplate#CollodionWetplateOntology/glossary"
        },
        {
          "@type": "DefinedTerm",
          "@id": "https://tijdgieterij.nl/ontology/collodion-wetplate#UVPhotography",
          "name": "UV photography",
          "description": "Imaging under ultraviolet light to reveal varnish and surface condition.",
          "inDefinedTermSet": "https://tijdgieterij.nl/ontology/collodion-wetplate#CollodionWetplateOntology/glossary"
        },
        {
          "@type": "DefinedTerm",
          "@id": "https://tijdgieterij.nl/ontology/collodion-wetplate#Varnishing",
          "name": "Varnishing",
          "description": "Applying a warm resin varnish to protect the delicate image layer.",
          "inDefinedTermSet": "https://tijdgieterij.nl/ontology/collodion-wetplate#CollodionWetplateOntology/glossary"
        },
        {
          "@type": "DefinedTerm",
          "@id": "https://tijdgieterij.nl/ontology/collodion-wetplate#Ventilation",
          "name": "Ventilation",
          "description": "The need to work with adequate fresh air to remove solvent and toxic vapours.",
          "inDefinedTermSet": "https://tijdgieterij.nl/ontology/collodion-wetplate#CollodionWetplateOntology/glossary"
        },
        {
          "@type": "DefinedTerm",
          "@id": "https://tijdgieterij.nl/ontology/collodion-wetplate#Washing",
          "name": "Washing",
          "description": "Rinsing residual chemistry from the plate with water to prevent later staining.",
          "inDefinedTermSet": "https://tijdgieterij.nl/ontology/collodion-wetplate#CollodionWetplateOntology/glossary"
        },
        {
          "@type": "DefinedTerm",
          "@id": "https://tijdgieterij.nl/ontology/collodion-wetplate#WetPlateCollodionProcess",
          "name": "Wet plate collodion process",
          "description": "The 19th-century photographic process in which a plate is coated with salted collodion, sensitised in a silver nitrate bath, then exposed, developed, fixed and varnished while the collodion is still moist.",
          "inDefinedTermSet": "https://tijdgieterij.nl/ontology/collodion-wetplate#CollodionWetplateOntology/glossary",
          "alternateName": "Collodion process",
          "url": "https://en.wikipedia.org/wiki/Collodion_process"
        },
        {
          "@type": "DefinedTerm",
          "@id": "https://tijdgieterij.nl/ontology/collodion-wetplate#XRF",
          "name": "X-ray fluorescence (XRF)",
          "description": "Non-destructive elemental analysis of the plate's metals.",
          "inDefinedTermSet": "https://tijdgieterij.nl/ontology/collodion-wetplate#CollodionWetplateOntology/glossary",
          "url": "https://en.wikipedia.org/wiki/X-ray_fluorescence"
        }
      ]
    },
    {
      "@type": "HowTo",
      "@id": "https://tijdgieterij.nl/ontology/collodion-wetplate#WetPlateCollodionProcess",
      "name": "Wet plate collodion process",
      "description": "The 19th-century photographic process in which a plate is coated with salted collodion, sensitised in a silver nitrate bath, then exposed, developed, fixed and varnished while the collodion is still moist.",
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Plate preparation",
          "text": "Cleaning and, where needed, edging the plate so the collodion adheres and the plate is free of dust and grease."
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Coating (pouring collodion)",
          "text": "Pouring salted collodion onto the plate in one smooth motion to form an even film."
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Sensitizing in the silver bath",
          "text": "Immersing the coated plate in a silver nitrate bath so light-sensitive silver halides form in the collodion film."
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "Exposure",
          "text": "Exposing the wet, sensitised plate in the camera to form a latent image."
        },
        {
          "@type": "HowToStep",
          "position": 5,
          "name": "Development",
          "text": "Flowing an iron-based developer over the plate to reduce exposed silver and reveal the image."
        },
        {
          "@type": "HowToStep",
          "position": 6,
          "name": "Fixing",
          "text": "Clearing the remaining unexposed silver salts in a fixer so the image becomes stable and light-fast."
        },
        {
          "@type": "HowToStep",
          "position": 7,
          "name": "Washing",
          "text": "Rinsing residual chemistry from the plate with water to prevent later staining."
        },
        {
          "@type": "HowToStep",
          "position": 8,
          "name": "Drying",
          "text": "Gently drying the plate, usually with low heat, before varnishing."
        },
        {
          "@type": "HowToStep",
          "position": 9,
          "name": "Varnishing",
          "text": "Applying a warm resin varnish to protect the delicate image layer."
        }
      ],
      "url": "https://en.wikipedia.org/wiki/Collodion_process"
    }
  ]
}
