          "@id": "https://tijdgieterij.nl/ontology/collodion-wetplate#Sandarac",
          "name": "Sandarac",
          "description": "A natural resin used as the film-former in traditional plate varnish.",
          "inDefinedTermSet": "https://tijdgieterij.nl/ontology/collodion-wetplate#CollodionWetplateOntology/glossary",
          "url": "https://en.wikipedia.org/wiki/Sandarac"
        },
        {
