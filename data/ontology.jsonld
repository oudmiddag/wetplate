          "inDefinedTermSet": "https://tijdgieterij.nl/ontology/collodion-wetplate#CollodionWetplateOntology/glossary"
        },
        {
          "@type": "DefinedTerm",
          "@id": "https://tijdgieterij.nl/ontology/collodion-wetplate#PortraitCollodionRecipe",
          "name": "Portrait collodion recipe",
          "description": "A collodion formulation tuned for portraiture, often paired with a Petzval lens.",
